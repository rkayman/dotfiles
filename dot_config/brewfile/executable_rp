#!/usr/bin/env zsh
# rp — Robpro: one CSV catalog of the macOS apps & utilities you use, and why.
#
#   catalog.csv columns: type,name,use,status,description,options,needed_by
#     type      HOW it installs, i.e. the Brewfile verb:
#               tap | brew | cask | mas | cargo | go | uv | npm | krew | flatpak | whalebrew
#     use       WHY it's here: base | dev | ai | media | fun | misc | lib | ...  (**use** = guessed)
#               lib = a dependency of something else; rp forces status=ignore, never emits it
#     status    keep | review | retire | ignore   (ignore = tracked, never installed directly)
#     options   everything after the name on a Brewfile line (e.g. id: 123, trusted: true)
#     needed_by maintained by `rp sync` for retire/ignore rows: the keep/review
#               items that still depend on it. Don't edit by hand.
#
# No host column on purpose: a machine is defined by its uses (rp create --for=dev,ai).
# Package management is per-OS; this catalog is the macOS one (REQ-20260928-017).
#
# Dependencies: zsh (or any POSIX sh), awk, sort, cut. Nothing from Homebrew,
# so it works on a freshly installed OS. `rp sync` and `rp deps` need brew.
emulate sh 2>/dev/null   # run as POSIX sh under zsh; the logic lives in awk
set -eu

RP_DIR=$(cd "$(dirname "$0")" && pwd)
DB=${RP_DB:-"$RP_DIR/catalog.csv"}
DUMP_OUT=${RP_DUMP:-"$RP_DIR/Brewfile-main"}
HDR='type,name,use,status,description,options,needed_by'

usage() {
  cat <<'EOF'
rp — manage macOS apps & utilities from one CSV (catalog.csv)

  rp create --for=USE[,USE...] [--status=keep[,review]] [--os=macos|linux|any]
            [--confirmed] [--out=FILE]
        Write a Brewfile for the given uses (or --for=all) to stdout or FILE.
        Default status: keep. --confirmed skips **guessed** uses.
        lib rows are never written: brew installs them with their dependents.

  rp sync [--from=BREWFILE] [--deps=FILE] [--dry-run]
        Merge what is installed on this machine into the catalog, refresh
        needed_by, and save the raw dump to Brewfile-main (history via chezmoi).
        New items arrive as use=**misc**, status=review; new dependencies as
        type=lib, use=lib, status=ignore. Nothing is ever deleted.
        Calls out: retired/ignored items still needed, ignored libs nothing
        needs, retired items still installed, catalog items missing here.
        --from / --deps feed a saved dump / `brew deps` output (offline, tests).

  rp deps [--deps=FILE]
        Same report as sync, read-only, plus kept brew rows that are really
        dependencies of other kept rows.

  rp prune [--yes] [--autoremove]
        Uninstall retired items that are installed here and that nothing you
        keep needs. Preview by default; --yes acts. Items still needed are
        listed and kept. --autoremove also runs `brew autoremove`.
        Apps (cask, mas) are never uninstalled: they are listed for you to
        remove with an app cleaner (then `brew uninstall --cask` for casks).

  rp bootstrap [--dry-run]
        New Mac, day zero: install Homebrew with the official installer, or
        update it to the latest if present. Then prints the next commands.

  rp check      Lint the catalog (types, statuses, lib consistency, guesses).
  rp list [--for=USE[,USE]] [--status=S[,S]] [--guessed]
  rp stats

  Env: RP_DB=catalog path (default: next to rp)   RP_DUMP=dump path (default: Brewfile-main)
EOF
}

# ---- shared awk library ------------------------------------------------------
# Never write `var (expr)` in these programs: busybox awk parses it as a call.
AWK_LIB='
function csvsplit(line, f,    n, i, c, q, fld, L) {
  for (i = 1; i <= 12; i++) f[i] = ""          # arrays persist between rows
  n = 0; fld = ""; q = 0; L = length(line)
  for (i = 1; i <= L; i++) {
    c = substr(line, i, 1)
    if (q) {
      if (c == "\"") {
        if (substr(line, i + 1, 1) == "\"") { fld = fld "\""; i++ } else q = 0
      } else fld = fld c
    } else if (c == "\"") q = 1
    else if (c == ",") { f[++n] = fld; fld = "" }
    else fld = fld c
  }
  f[++n] = fld
  return n
}
function csvq(s) { if (s ~ /[,"]/) { gsub(/"/, "\"\"", s); return "\"" s "\"" } return s }
function bare(u) { gsub(/\*/, "", u); return u }
function guessed(u) { return u ~ /^\*\*.*\*\*$/ }
function inlist(x, list,    a, n, i) {
  if (list == "" || list == "all") return 1
  n = split(list, a, ",")
  for (i = 1; i <= n; i++) if (a[i] == x) return 1
  return 0
}
function kind(t) { return t == "lib" ? "brew" : t }   # heals legacy type=lib rows
function islib(t, u) { return t == "lib" || bare(u) == "lib" }
function typeorder(t) {
  return index("tap brew cask mas cargo go uv npm krew flatpak whalebrew", kind(t))
}
function sortkey(t, name) { return sprintf("%03d|%s", typeorder(t), tolower(name)) }
function shortname(n) { sub(/.*\//, "", n); return n }
function sortwords(s,    a, n, i, j, x, out, sep) {     # dedupe + sort a space list
  n = split(s, a, " "); out = ""; sep = ""
  for (i = 2; i <= n; i++) { x = a[i]; for (j = i - 1; j >= 1 && a[j] > x; j--) a[j + 1] = a[j]; a[j + 1] = x }
  for (i = 1; i <= n; i++) if (i == 1 || a[i] != a[i - 1]) { out = out sep a[i]; sep = " " }
  return out
}
# read `brew deps` output ("name: dep dep ...") into GN (count), GP[i] (parent), GD[i] (deps)
function loadgraph(file,    line, p, got) {
  got = 0
  while ((getline line < file) > 0) {
    if (index(line, ":") == 0) continue
    got = 1
    p = line; sub(/:.*/, "", p); sub(/^[^:]*:[ ]*/, "", line)
    GP[++GN] = p; GD[GN] = line
  }
  close(file)
  return got
}
'

need_db() { [ -f "$DB" ] || { echo "rp: catalog not found: $DB" >&2; exit 1; }; }

# $1 = output file. Dependency graph for every brew/cask the catalog keeps
# (keep|review), plus everything installed here. Declared deps, so the result
# is the same on every Mac. Empty file if brew is unavailable.
brew_graph() {
  : > "$1"
  command -v brew >/dev/null 2>&1 || return 0
  names=$(awk "$AWK_LIB"'NR > 1 { csvsplit($0, f); if ((f[1] == "brew" || f[1] == "cask") && (f[4] == "keep" || f[4] == "review")) print f[2] }' "$DB")
  # shellcheck disable=SC2086
  if [ -n "$names" ] && ! brew deps --for-each $names >> "$1" 2>"$1.err"; then
    echo "rp: 'brew deps --for-each' failed; needed_by uses installed formulae only:" >&2
    sed 's/^/    /' "$1.err" | head -5 >&2
  fi
  brew deps --installed >> "$1" 2>/dev/null || :
}

# ---- create -----------------------------------------------------------------
cmd_create() {
  uses=""; statuses="keep"; os=""; confirmed=0; out=""
  for a in "$@"; do
    case $a in
      --for=*) uses=${a#--for=} ;;
      --status=*) statuses=${a#--status=} ;;
      --os=*) os=${a#--os=} ;;
      --confirmed) confirmed=1 ;;
      -o=*|--out=*) out=${a#*=} ;;
      *) echo "rp create: unknown option $a" >&2; exit 2 ;;
    esac
  done
  [ -n "$uses" ] || { echo "rp create: --for=USE is required (e.g. --for=base,dev or --for=all)" >&2; exit 2; }
  if [ -z "$os" ]; then
    case $(uname -s) in Darwin) os=macos ;; *) os=linux ;; esac
  fi
  case $os in macos|linux|any) ;; *) echo "rp create: --os must be macos, linux or any" >&2; exit 2 ;; esac
  need_db
  result=$(awk -v USES="$uses" -v STAT="$statuses" -v OS="$os" -v CONF="$confirmed" \
      "$AWK_LIB"'
    function emit(k,    j) {
      if (!(k in cnt) || (k in done)) return
      done[k] = 1
      printf "\n## %s (%d) ##\n", toupper(k), cnt[k]
      for (j = 1; j <= cnt[k]; j++) print body[k, j]
    }
    NR == 1 { next }
    {
      n = csvsplit($0, f); t = f[1]; name = f[2]; u = f[3]; s = f[4]; d = f[5]; o = f[6]
      if (!inlist(s, STAT)) next
      if (islib(t, u)) { libs++; next }
      if (t != "tap") {
        if (!inlist(bare(u), USES)) next
        if (CONF && guessed(u)) next
      }
      maconly = (t == "cask" || t == "mas"); linuxonly = (t == "flatpak")
      if (OS == "linux" && maconly) { skipped++; next }
      if (OS == "macos" && linuxonly) { skipped++; next }
      guard = ""
      if (OS == "any" && maconly) guard = " if OS.mac?"
      if (OS == "any" && linuxonly) guard = " if OS.linux?"
      opts = ""
      if (o != "") opts = ", " o
      line = t " \"" name "\"" opts guard
      if (t == "tap") { taps[++nt] = line; next }
      k = bare(u); if (!(k in seen)) { seen[k] = 1; order[++nu] = k }
      cnt[k]++
      tag = guessed(u) ? "  [use guessed]" : ""
      body[k, cnt[k]] = "# " d tag "\n" line
    }
    END {
      # no timestamp or hostname: identical catalog => identical file (no chezmoi churn)
      print "# Generated by rp from catalog.csv -- do not edit; change the catalog and regenerate"
      tag = CONF ? "  confirmed-only" : ""
      print "# for=" USES "  status=" STAT "  os=" OS tag
      if (skipped) print "# skipped " skipped " entries not available on " OS
      if (libs) print "# omitted " libs " lib entries (installed automatically as dependencies)"
      print ""
      for (i = 1; i <= nt; i++) print taps[i]
      m = split(USES, req, ",")
      for (i = 1; i <= m; i++) emit(req[i])
      for (i = 1; i <= nu; i++) emit(order[i])
    }
  ' "$DB")
  if [ -n "$out" ]; then printf '%s\n' "$result" > "$out"; echo "rp: wrote $out" >&2
  else printf '%s\n' "$result"; fi
}

# ---- sync / deps --------------------------------------------------------------
# rp deps == rp sync --dry-run --verbose
cmd_sync() {
  from=""; deps=""; dry=0; verbose=0
  for a in "$@"; do
    case $a in
      --from=*) from=${a#--from=} ;;
      --deps=*) deps=${a#--deps=} ;;
      --dry-run) dry=1 ;;
      --verbose) verbose=1 ;;
      *) echo "rp sync: unknown option $a" >&2; exit 2 ;;
    esac
  done
  [ -f "$DB" ] || printf '%s\n' "$HDR" > "$DB"
  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/rp.XXXXXX")
  trap 'rm -rf "$tmpdir"' EXIT
  live=0
  if [ -z "$from" ]; then
    command -v brew >/dev/null 2>&1 || { echo "rp sync: brew not found; use --from=BREWFILE" >&2; exit 1; }
    from="$tmpdir/dump.Brewfile"; live=1
    # descriptions are on by default (--describe was removed from brew)
    brew bundle dump --force --no-vscode --file="$from"
  fi
  if [ -z "$deps" ]; then deps="$tmpdir/graph.txt"; brew_graph "$deps"; fi
  awk -v REPORT="$tmpdir/report" -v GRAPH="$deps" -v VERBOSE="$verbose" -v PLAN="${RP_PLAN:-}" "$AWK_LIB"'
    BEGIN { havegraph = loadgraph(GRAPH) }
    FNR == 1 && NR != 1 { indump = 1 }
    !indump {
      if (FNR == 1) next
      n = csvsplit($0, f); k = kind(f[1]) SUBSEP f[2]
      T[k] = kind(f[1]); N[k] = f[2]; U[k] = f[3]; S[k] = f[4]; D[k] = f[5]; O[k] = f[6]; NB[k] = f[7]
      if (f[1] == "lib") { U[k] = "lib"; healed++ }                 # legacy type=lib -> brew + use=lib
      if (bare(U[k]) == "lib" && S[k] != "ignore") { S[k] = "ignore"; forced++ }
      keys[++nk] = k; next
    }
    # ---- Brewfile dump ----
    /^# / { desc = substr($0, 3); next }
    /^(tap|brew|cask|mas|cargo|go|uv|npm|krew|flatpak|whalebrew) "/ {
      t = $1
      rest = substr($0, length(t) + 3)             # after: type "
      q = index(rest, "\""); name = substr(rest, 1, q - 1)
      opts = substr(rest, q + 1); sub(/^, */, "", opts)
      k = t SUBSEP name; installed[k] = 1
      if (k in T) {
        if (O[k] != opts) { O[k] = opts; changed++ }
        if ((D[k] == "" || D[k] ~ /^\*\*unknown/) && desc != "") { D[k] = desc; changed++ }
      } else {
        N[k] = name; O[k] = opts; NB[k] = ""
        D[k] = "**unknown - please describe**"
        if (desc != "") D[k] = desc
        T[k] = t; U[k] = "**misc**"; S[k] = "review"
        keys[++nk] = k; isnew[k] = 1
      }
      desc = ""; next
    }
    { desc = "" }   # vscode lines, blanks, section headers: ignored (REQ-20260925-002)
    END {
      # which formulae does *anything* depend on (for classifying new rows)
      for (i = 1; i <= GN; i++) { m = split(GD[i], a, " "); for (j = 1; j <= m; j++) { ANYDEP[a[j]] = 1; ANYDEP[shortname(a[j])] = 1 } }
      for (i = 1; i <= nk; i++) {
        k = keys[i]
        if (!(k in isnew)) continue
        if (T[k] == "brew" && (N[k] in ANYDEP)) { U[k] = "lib"; S[k] = "ignore"; added[++na] = "brew " N[k] "  (dependency: use=lib)" }
        else added[++na] = T[k] " " N[k]
      }
      # parents that count: brew/cask rows you keep or are reviewing
      for (i = 1; i <= nk; i++) {
        k = keys[i]
        if ((T[k] == "brew" || T[k] == "cask") && (S[k] == "keep" || S[k] == "review")) { KR[N[k]] = 1; KR[shortname(N[k])] = 1 }
      }
      for (i = 1; i <= GN; i++) {
        p = GP[i]
        if (!(p in KR) && !(shortname(p) in KR)) continue
        m = split(GD[i], a, " ")
        for (j = 1; j <= m; j++) { d = shortname(a[j]); if (d != shortname(p)) NEED[d] = NEED[d] " " shortname(p) }
      }
      for (i = 1; i <= nk; i++) {
        k = keys[i]; sn = shortname(N[k])
        if (havegraph) {
          old = NB[k]
          NB[k] = ""
          if (S[k] == "retire" || S[k] == "ignore") NB[k] = sortwords(NEED[sn])
          if (NB[k] != old) nbchanged++
        }
        if (S[k] == "retire" && NB[k] != "") stillneeded[++ns] = N[k] "  <- " NB[k]
        if (S[k] == "ignore" && bare(U[k]) == "lib" && NB[k] == "" && havegraph) orphan[++no] = N[k]
        if (S[k] == "retire" && (k in installed)) stillinst[++nr] = T[k] " " N[k]
        # prune plan: retired, installed here, and nothing you keep needs it
        if (PLAN != "" && S[k] == "retire" && (k in installed)) {
          if (NB[k] == "") printf "go\t%s\t%s\t%s\n", T[k], N[k], O[k] > PLAN
          else printf "skip\t%s\t%s\t%s\n", T[k], N[k], NB[k] > PLAN
        }
        if (!(k in installed) && S[k] != "retire" && S[k] != "ignore") missing[++nm] = T[k] " " N[k]
        if (VERBOSE && T[k] == "brew" && S[k] != "retire" && S[k] != "ignore" && (sn in NEED)) alsodep[++nd] = N[k] "  <- " sortwords(NEED[sn])
        printf "%s\t%s,%s,%s,%s,%s,%s,%s\n", sortkey(T[k], N[k]), csvq(T[k]), csvq(N[k]), csvq(U[k]), csvq(S[k]), csvq(D[k]), csvq(O[k]), csvq(NB[k])
      }
      R = REPORT
      printf "added %d, updated %d fields, needed_by changed %d, not installed here %d\n", na, changed, nbchanged, nm > R
      for (i = 1; i <= na; i++) print "  + " added[i] > R
      if (!havegraph) print "  (no dependency data: needed_by left as is, new formulae not checked for lib)" > R
      if (healed) print "  normalized " healed " legacy type=lib rows to type=brew, use=lib" > R
      if (forced) print "  set status=ignore on " forced " use=lib rows" > R
      if (PLAN != "" && !havegraph) print "nodata" > PLAN
      if (PLAN != "") printf "" > PLAN
      if (ns) { print "retired but still needed (" ns ") -- decide: keep it, or drop what needs it:" > R; for (i = 1; i <= ns; i++) print "  ^ " stillneeded[i] > R }
      if (no) { print "ignored libs nothing you keep needs (" no ") -- retire?:" > R; for (i = 1; i <= no; i++) print "  ! " orphan[i] > R }
      if (nr) { print "retired but still installed here (" nr ") -- brew uninstall?:" > R; for (i = 1; i <= nr; i++) print "  x " stillinst[i] > R }
      if (nm) { print "in catalog, not installed here (" nm "):" > R; for (i = 1; i <= nm; i++) print "  - " missing[i] > R }
      if (nd) { print "kept brew rows other kept rows depend on (" nd ") -- lib candidates:" > R; for (i = 1; i <= nd; i++) print "  ~ " alsodep[i] > R }
    }
  ' "$DB" "$from" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 | cut -f2- > "$tmpdir/body"
  { printf '%s\n' "$HDR"; cat "$tmpdir/body"; } > "$tmpdir/new.csv"
  [ -n "${RP_PLAN:-}" ] || cat "$tmpdir/report" >&2   # rp prune prints its own summary
  if [ "$dry" -eq 1 ]; then
    [ -n "${RP_PLAN:-}" ] || echo "rp: dry run, nothing written" >&2
  else
    cp "$DB" "$DB.bak"
    cat "$tmpdir/new.csv" > "$DB"   # overwrite in place: keeps symlinks (chezmoi) and permissions
    echo "rp sync: wrote $DB (backup: $DB.bak)" >&2
    if [ "$live" -eq 1 ]; then cat "$from" > "$DUMP_OUT"; echo "rp sync: wrote $DUMP_OUT" >&2; fi
  fi
}

# ---- check ------------------------------------------------------------------
cmd_check() {
  need_db
  awk -v HDR="$HDR" "$AWK_LIB"'
    function err(m) { print "error: line " NR ": " m; errs++ }
    function warn(m) { print "warn:  line " NR ": " m; warns++ }
    NR == 1 { if ($0 != HDR) warn("header is \"" $0 "\", expected \"" HDR "\""); next }
    {
      n = csvsplit($0, f); t = f[1]; name = f[2]; u = f[3]; s = f[4]
      if (n < 6 || n > 7) err(n " fields")
      if (!index(" tap brew lib cask mas cargo go uv npm krew flatpak whalebrew ", " " t " ")) err("unknown type \"" t "\"")
      if (!index(" keep review retire ignore ", " " s " ")) err(name ": unknown status \"" s "\"")
      if (name == "") err("empty name")
      k = kind(t) SUBSEP name; if (k in seen) err(name ": duplicate of line " seen[k]); seen[k] = NR
      if (t == "lib") warn(name ": legacy type=lib; should be type=brew, use=lib (rp sync fixes it)")
      if (bare(u) == "lib" && s != "ignore") warn(name ": use=lib should have status=ignore (rp sync fixes it)")
      if (bare(u) == "lib" && t != "brew" && t != "lib") warn(name ": use=lib on a " t " row; only brew formulae are dependencies")
      if (t != "tap" && u == "") warn(name ": no use")
      if (guessed(u)) g++
      if (f[5] ~ /^\*\*/) warn(name ": description unconfirmed")
      if (f[7] != "" && s != "retire" && s != "ignore") warn(name ": needed_by set on a " s " row (sync clears it)")
      if (t != "tap" && t != "lib" && s != "retire" && s != "ignore") { sn = name; sub(/.*\//, "", sn); if (sn in names && names[sn] != t) warn(name ": also listed as " names[sn]); names[sn] = t }
    }
    END { printf "%d errors, %d warnings, %d guessed uses\n", errs, warns, g; if (errs) exit 1 }
  ' "$DB"
}

# ---- prune ------------------------------------------------------------------
# $1 = echo | run ; $2 type ; $3 name ; $4 options. With echo, prints the command.
uninstall_one() {
  pre=""; [ "$1" = echo ] && pre="echo"
  case $2 in
    brew)      $pre brew uninstall --formula "$3" ;;
    tap)       $pre brew untap "$3" ;;
    cask|mas)  echo "($2 $3: apps are yours to remove with an app cleaner; rp never uninstalls them)"; return 1 ;;
    cargo)     $pre cargo uninstall "$3" ;;
    uv)        $pre uv tool uninstall "$3" ;;
    npm)       $pre npm uninstall -g "$3" ;;
    krew)      $pre kubectl krew uninstall "$3" ;;
    whalebrew) $pre whalebrew uninstall "$3" ;;
    flatpak)   $pre flatpak uninstall -y "$3" ;;
    *)         echo "   ($2 $3: no uninstaller; remove it by hand)"; return 1 ;;
  esac
}

cmd_prune() {
  yes=0; autoremove=0; pass=""
  for a in "$@"; do
    case $a in
      --yes|-y) yes=1 ;;
      --autoremove) autoremove=1 ;;
      --from=*|--deps=*) pass="$pass $a" ;;
      *) echo "rp prune: unknown option $a" >&2; exit 2 ;;
    esac
  done
  need_db
  plan=$(mktemp "${TMPDIR:-/tmp}/rp-plan.XXXXXX")
  # shellcheck disable=SC2086
  ( RP_PLAN="$plan"; export RP_PLAN; cmd_sync --dry-run $pass ) || { rm -f "$plan"; exit 1; }
  if grep -q '^nodata' "$plan"; then
    rm -f "$plan"
    echo "rp prune: no dependency data, so I can't prove nothing needs these. Refusing." >&2; exit 1
  fi
  # Apps (cask, mas) are never uninstalled by rp: Rob removes them with an app
  # cleaner first to catch remnants (REQ-20260929-021, OQ-17). Everything else:
  # tools first, formulae next, taps last.
  go=$(awk -F '\t' '$1 == "go" && $2 != "cask" && $2 != "mas" { o = ($2 == "tap") ? 3 : ($2 == "brew") ? 2 : 1; print o "\t" $2 "\t" $3 "\t" $4 }' "$plan" | LC_ALL=C sort | cut -f2-)
  apps=$(awk -F '\t' '$1 == "go" && ($2 == "cask" || $2 == "mas") {
      if ($2 == "cask") printf "0\t   cask  %-28s then: brew uninstall --cask %s\n", $3, $3
      else { id = $4; sub(/.*id: */, "", id); sub(/[^0-9].*/, "", id); printf "1\t   mas   %-28s (App Store id %s)\n", $3, id }
    }' "$plan" | LC_ALL=C sort | cut -f2-)
  skip=$(awk -F '\t' '$1 == "skip" { print "   " $2 " " $3 "  <- " $4 }' "$plan")
  rm -f "$plan"
  if [ -n "$skip" ]; then
    echo "Keeping (retired, but still needed by something you keep):"
    printf '%s\n' "$skip"
  fi
  if [ -n "$apps" ]; then
    echo "Apps to remove yourself (app cleaner first; rp never uninstalls apps):"
    printf '%s\n' "$apps"
  fi
  if [ -z "$go" ] && [ -z "$apps" ]; then
    echo "Nothing to prune: no retired item is installed here unless something still needs it."
  elif [ -n "$go" ]; then
    echo "Retired, installed here, and nothing you keep needs them:"
    printf '%s\n' "$go" | while IFS="$(printf '\t')" read -r t n o; do uninstall_one echo "$t" "$n" "$o" || :; done | sed 's/^/   /'
  fi
  [ "$autoremove" -eq 1 ] && echo "   brew autoremove   (orphaned dependencies)"
  if [ "$yes" -eq 0 ]; then
    [ -n "$go" ] || [ "$autoremove" -eq 1 ] && echo "Preview only. Run: rp prune --yes$( [ "$autoremove" -eq 1 ] && echo ' --autoremove')"
    return 0
  fi
  failed=""
  if [ -n "$go" ]; then
    # two passes: a retired item another retired item depends on can only go second
    for pass_no in 1 2; do
      failed=""
      todo=$go
      go=$(printf '%s\n' "$todo" | while IFS="$(printf '\t')" read -r t n o; do
        echo "-> $t $n" >&2
        uninstall_one run "$t" "$n" "$o" >&2 || printf '%s\t%s\t%s\n' "$t" "$n" "$o"
      done)
      [ -z "$go" ] && break
      [ "$pass_no" -eq 1 ] && echo "retrying $(printf '%s\n' "$go" | wc -l | tr -d ' ') failed item(s) once more" >&2
    done
    failed=$go
  fi
  [ "$autoremove" -eq 1 ] && { echo "-> brew autoremove"; brew autoremove || :; }
  if [ -n "$failed" ]; then
    echo "Could not remove (see errors above):"
    printf '%s\n' "$failed" | cut -f1-2 | sed 's/^/   /; s/\t/ /'
  fi
  echo "Done. Run ./rp sync to refresh Brewfile-main and the catalog."
  [ -z "$failed" ]
}

# ---- bootstrap --------------------------------------------------------------
BREW_INSTALLER=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
cmd_bootstrap() {
  dry=0
  for a in "$@"; do
    case $a in
      --dry-run) dry=1 ;;
      *) echo "rp bootstrap: unknown option $a" >&2; exit 2 ;;
    esac
  done
  [ "$(uname -s)" = Darwin ] || { echo "rp bootstrap: macOS only; package management is per-OS (REQ-20260928-017)" >&2; exit 1; }
  find_brew() {
    for b in "$(command -v brew 2>/dev/null || :)" /opt/homebrew/bin/brew /usr/local/bin/brew; do
      [ -n "$b" ] && [ -x "$b" ] && { printf '%s\n' "$b"; return 0; }
    done
    return 1
  }
  if brew_bin=$(find_brew); then
    echo "Homebrew found at $brew_bin. Updating to the latest Homebrew."
    if [ "$dry" -eq 1 ]; then echo "   $brew_bin update"; else "$brew_bin" update; fi
  else
    echo "Installing Homebrew with the official installer."
    echo "It will ask for your password and install the Xcode Command Line Tools if needed."
    if [ "$dry" -eq 1 ]; then
      echo "   /bin/bash -c \"\$(curl -fsSL $BREW_INSTALLER)\""
      echo "(dry run: nothing installed)"; return 0
    fi
    /bin/bash -c "$(curl -fsSL "$BREW_INSTALLER")"
    brew_bin=$(find_brew) || { echo "rp bootstrap: installer finished but brew was not found" >&2; exit 1; }
  fi
  [ "$dry" -eq 1 ] && { echo "(dry run: nothing changed)"; return 0; }
  eval "$("$brew_bin" shellenv)"
  "$brew_bin" --version | head -1
  if ! grep -qs 'brew shellenv' "$HOME/.zprofile"; then
    echo
    echo "New shells won't find brew yet. Add this to ~/.zprofile (in chezmoi):"
    echo "   eval \"\$($brew_bin shellenv)\""
  fi
  echo
  echo "Next:"
  echo "   brew bundle --file=\"$RP_DIR/Brewfile-base\""
  echo "   $RP_DIR/rp create --for=dev,ai | brew bundle --file=-     # this Mac's purpose"
}

# ---- list / stats -----------------------------------------------------------
cmd_list() {
  uses=""; statuses=""; g=0
  for a in "$@"; do
    case $a in
      --for=*) uses=${a#--for=} ;;
      --status=*) statuses=${a#--status=} ;;
      --guessed) g=1 ;;
      *) echo "rp list: unknown option $a" >&2; exit 2 ;;
    esac
  done
  need_db
  awk -v USES="$uses" -v STAT="$statuses" -v G="$g" "$AWK_LIB"'
    NR == 1 { print "USE\tSTATUS\tTYPE\tNAME\tDESCRIPTION\tNEEDED_BY"; next }
    { csvsplit($0, f)
      if (!inlist(bare(f[3]), USES) || !inlist(f[4], STAT)) next
      if (G && !guessed(f[3])) next
      print f[3] "\t" f[4] "\t" f[1] "\t" f[2] "\t" substr(f[5], 1, 50) "\t" f[7] }
  ' "$DB" | column -t -s "$(printf '\t')"
}

cmd_stats() {
  need_db
  awk "$AWK_LIB"'
    NR == 1 { next }
    { csvsplit($0, f); u = bare(f[3]); U[u]++; S[f[4]]++; T[f[1]]++; if (guessed(f[3])) G[u]++; total++ }
    END {
      printf "%d items\n\nuse      total  guessed\n", total
      for (u in U) printf "%-8s %5d  %7d\n", u, U[u], G[u]
      printf "\nstatus: "; for (s in S) printf "%s=%d  ", s, S[s]
      printf "\ntype:   "; for (t in T) printf "%s=%d  ", t, T[t]
      print ""
    }
  ' "$DB"
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  create) cmd_create "$@" ;;
  sync)   cmd_sync "$@" ;;
  deps)   cmd_sync --dry-run --verbose "$@" ;;
  prune)  cmd_prune "$@" ;;
  bootstrap) cmd_bootstrap "$@" ;;
  check)  cmd_check ;;
  list)   cmd_list "$@" ;;
  stats)  cmd_stats ;;
  help|-h|--help) usage ;;
  *) echo "rp: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
